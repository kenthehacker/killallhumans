# Telemetry logs
logs/

# Iter-009l (Opus Mi2): racing-line cache is a deterministic build
# artifact, regenerated on first cold run from gate geometry +
# select_velocity_mps. Committing it is misleading (last-writer-wins
# semantics; cache often ends up with a toy-test layout instead of
# race_01's offsets).
planning/racing_line_cache.json

# Iter-022: residual_weights.npz is a regenerable artifact (zero-init
# placeholder; iter-031 fits it from collected traces). Iter-031: stays
# gitignored unless tests/test_residual_matrix_gain.py is GREEN — in
# that case un-comment to commit the validated weights file alongside.
control/residual_weights.npz
control/residual_weights_meta.json
control/residual_weights.tmp.npz
# Iter-025: residual_dataset.npz is the collected training data
# (regenerable via scripts/collect_residual_dataset.py); also gitignored.
control/residual_dataset.npz
# Closed-loop harness / sweep telemetry artifacts (regenerate locally)
captures/sim_closed_loop.jsonl.gz
captures/sim_cl_short.jsonl.gz
captures/sweep_*.jsonl.gz
