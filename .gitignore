/external_data
.artifacts/
/.cache/

# Python virtual envs and bytecode caches
.venv/
__pycache__/
*.py[cod]

# Simulation/demo generated binary artifacts
simulation/example_output/*.ppm
simulation/example_output/*.png
simulation/example_output/*.jpg
simulation/example_output/*.jpeg


gate_detection/training/dataset/images
gate_detection/training/dataset/
gate_detection/training/val_failures

# Telemetry logs
logs/

# Obsolete pre-content-addressed racing-line artifact. Current artifacts live
# under `.cache/racing-lines/<sha256>.json`; keep a locally lingering legacy
# file ignored so it cannot be mistaken for current optimizer state.
planning/racing_line_cache.json

# Iter-022: residual_weights.npz is a regenerable artifact (zero-init
# placeholder; iter-031 fits it from collected traces). Iter-031: stays
# gitignored unless tests/test_residual_matrix_gain.py is GREEN — in
# that case un-comment to commit the validated weights file alongside.
control/residual_weights.npz
control/residual_weights_meta.json
control/residual_weights.tmp.npz
# Atomic trainer resume state (model + optimizer + RNG + split/history).
control/residual_weights_checkpoint.npz
# Iter-025: residual_dataset.npz is the collected training data
# (regenerable via scripts/collect_residual_dataset.py); also gitignored.
control/residual_dataset.npz
# Closed-loop harness / sweep / live-run telemetry artifacts (regenerate
# locally). All captures/*.jsonl.gz are per-run telemetry recordings — large
# binary, regenerable by re-flying the sim; never commit them.
captures/*.jsonl.gz
# Per-run logs, analysis dumps, and the session gate-map reference are all
# regenerable run artifacts too (real-sim loop, iters 1-70) — never commit them.
captures/*.log
captures/*.txt
captures/*.json
captures/*.npz
# VQ2 writes diagnostic frames beside each per-run trace after safe cleanup.
captures/*.png
# Full decoded-frame replay sessions are private competition recordings.
# Keep them out of Git pending explicit organizer approval and an intentional
# artifact-store/Git-LFS decision; never commit actual frames by default.
captures/replays/
# Structured autonomous-loop state and isolated-worktree metadata are local.
.aigp-loop/
